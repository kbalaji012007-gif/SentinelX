# ═══════════════════════════════════════════════════════════════
# SentinelX AI – Environment Variables
# Copy this file to .env and fill in the values
# ═══════════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────────
APP_NAME="SentinelX AI"
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ── Server ───────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
WORKERS=1

# ── CORS (comma-separated for multiple origins) ─────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Supabase ─────────────────────────────────────────────────
SUPABASE_URL=https://epxtwnulvkmtxwfesxnc.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql+asyncpg://postgres:your-password@db.epxtwnulvkmtxwfesxnc.supabase.co:5432/postgres

# ── JWT Authentication ───────────────────────────────────────
JWT_SECRET_KEY=change-this-to-a-secure-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Google Gemini AI ─────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── External Integrations (Optional) ────────────────────────
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
SHODAN_API_KEY=

# ── Notification Channels (Optional) ────────────────────────
SLACK_WEBHOOK_URL=
PAGERDUTY_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── Frontend Environment Variables (Vite) ────────────────────
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=https://epxtwnulvkmtxwfesxnc.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
